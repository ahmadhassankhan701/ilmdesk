NEXT_PUBLIC_FIREBASE_APIKEY=
NEXT_PUBLIC_FIREBASE_AUTHDOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECTID=
NEXT_PUBLIC_FIREBASE_STORAGEBUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGINGSENDERID=
NEXT_PUBLIC_FIREBASE_APPID=
NEXT_PUBLIC_URL=http://localhost:3000

# This address becomes the brand owner on sign-in.
# Use the same address in ownerEmail() inside firestore.rules before deploying rules.
NEXT_PUBLIC_OWNER_EMAIL=

# Firebase user id that becomes a brand admin on sign-in, even if that
# account registered as a teacher. Use the same id in brandAdminId()
# inside firestore.rules before deploying rules.
NEXT_PUBLIC_BRAND_ADMIN_UID=

# Lesson review mail. Leave both blank until Resend is connected.
# Approve and reject still finish; the desk gets a toast if mail cannot be sent.
# RESEND_FROM looks like: Ilmdesk <notes@ilmdesk.com>
RESEND_API_KEY=
RESEND_FROM=
